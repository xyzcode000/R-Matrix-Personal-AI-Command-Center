APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
MAX_UPLOAD_BYTES=10485760
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional web research provider; search queries are sent to Tavily.
TAVILY_API_KEY=
# Optional task reminder email. SMTP credentials remain backend-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Required for owner login; generate a private value and store it only in backend/.env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Authentication cookies are secure only when served over HTTPS; keep false for localhost development.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
# Second factor: after the password, a six-digit code is sent to the paired Telegram chat.
# Applied only when a bot token is configured and a chat is paired.
AUTH_TELEGRAM_OTP_ENABLED=true
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_RESEND_SECONDS=30
AUTH_OTP_MAX_ATTEMPTS=5
# Set true in a control-plane deployment to hide the local chat/document APIs.
CONTROL_PLANE_ONLY=false
# Optional. Semicolon-separated authorized project directories; defaults to this repository root.
# AUTHORIZED_PROJECT_DIRS=C:\Users\YourName\source\project-a;D:\work\project-b
# Cloud providers are disabled until both their server-side key and model are set.
# A cloud provider never receives local document passages without per-request consent.
# Optional. Defaults to %LOCALAPPDATA%\RMatrixCommandCenter on Windows.
# R_MATRIX_DATA_DIR=C:\Users\YourName\AppData\Local\RMatrixCommandCenter

# Every private /api path requires the owner session. Set to false only for a
# temporary local debugging session; it weakens access control.
REQUIRE_API_AUTH=true

# Local document OCR (Tesseract). Both paths are optional: the backend also probes
# PATH and the standard Windows installation folders, then verifies the executable
# and runs a synthetic OCR probe. Run scripts\setup-document-ocr-windows.ps1 once.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
# Requested OCR languages (comma-separated). Hindi is used when hin.traineddata exists.
DOCUMENT_OCR_LANGUAGES=eng,hin
DOCUMENT_OCR_MAX_PAGES=10
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_PAGE_TIMEOUT_SECONDS=25
DOCUMENT_OCR_TOTAL_TIMEOUT_SECONDS=300
# Pages with fewer native characters than this are sent to local OCR.
DOCUMENT_NATIVE_TEXT_MIN_CHARS=40
DOCUMENT_MAX_PDF_PAGES=100
